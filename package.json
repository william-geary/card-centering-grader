{
  "name": "card-centering-grader",
  "private": true,
  "version": "2.1.0",
  "description": "Manual trading card centering measurement, in the browser and as a desktop app",
  "license": "MIT",
  "author": "William Geary",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "test:e2e": "playwright test --project=desktop --project=phone",
    "test:all": "npm run typecheck && npm test && npm run test:e2e",
    "docs:screenshots": "playwright test --project=docs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.4",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2"
  }
}
